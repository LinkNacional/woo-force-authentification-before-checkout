#. translators: %s: the WooCommerce setting name.
#: Includes/WcForceAuthSettings.php:125
#, php-format
msgid "Register and login (unavailable: enable “%s” in WooCommerce first)"
msgstr ""

#: Includes/WcForceAuthSettings.php:129
msgid "Turns email OTP (one-time password) authentication on and chooses how it behaves. While disabled, the default WooCommerce login and registration forms are used."
msgstr ""

#: Includes/WcForceAuthSettings.php:131
msgid "Defines whether customers sign in with an emailed code and whether new accounts can be created."
msgstr ""

#: Includes/WcForceAuthSettings.php:132
msgid "\"Disabled\": keeps the standard WooCommerce login/registration. \"Login only\": only customers that already have an account can sign in with a code (the native registration form stays available for new customers). \"Register and login\": the 2-in-1 flow — the customer types their email, and we log them in if the account exists or create a passwordless account with the same code if it does not."
msgstr ""

#: Includes/WcForceAuthSettings.php:135
#: Includes/WcForceAuthSettings.php:140
msgid "Code expiration in Minutes"
msgstr ""

#: Includes/WcForceAuthSettings.php:139
msgid "How long, in minutes, a code stays valid after it is sent to the customer."
msgstr ""

#: Includes/WcForceAuthSettings.php:141
msgid "Lifetime of each verification code."
msgstr ""

#: Includes/WcForceAuthSettings.php:142
msgid "Accepts 1 to 60 minutes. If left empty, 10 minutes is used. After this time the code stops working and the customer must request a new one."
msgstr ""

#: Includes/WcForceAuthSettings.php:150
#: Includes/WcForceAuthSettings.php:155
msgid "Resend interval"
msgstr ""

#: Includes/WcForceAuthSettings.php:154
msgid "How long, in seconds, the customer must wait before requesting a new code."
msgstr ""

#: Includes/WcForceAuthSettings.php:156
msgid "Countdown shown until the \"Resend\" button is enabled."
msgstr ""

#: Includes/WcForceAuthSettings.php:157
msgid "Accepts 0 to 600 seconds. If left empty, 30 seconds is used. This value also drives the countdown timer on the verification screen and prevents rapid repeated requests."
msgstr ""

