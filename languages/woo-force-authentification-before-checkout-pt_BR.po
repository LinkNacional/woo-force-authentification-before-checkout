#: Includes/WcForceAuthCheckout.php:194
#: Includes/WcForceAuthCheckoutSettings.php:86
#: Includes/WcForceAuthCheckoutSettings.php:132
msgid "Please log in or register to complete your purchase."
msgstr "Faça login ou cadastre-se para concluir sua compra."

#: Includes/WcForceAuthCheckoutSettings.php:112
#: Includes/WcForceAuthSettings.php:94
msgid "General"
msgstr "Geral"

#: Includes/WcForceAuthCheckoutSettings.php:118
#: Includes/WcForceAuthCheckoutSettings.php:124
msgid "Force authentication"
msgstr "Forçar autenticação"

#: Includes/WcForceAuthCheckoutSettings.php:122
msgid "Require customers to log in or register before checkout."
msgstr ""
"Exigir que os clientes façam login ou se cadastrem antes da finalização."

#: Includes/WcForceAuthCheckoutSettings.php:123
msgid ""
"When enabled, guests who reach the checkout are redirected to the account "
"page to authenticate first."
msgstr ""
"Quando ativado, visitantes que chegam à finalização são redirecionados para "
"a página de conta para se autenticarem primeiro."

#: Includes/WcForceAuthCheckoutSettings.php:125
msgid "Turns the \"login before checkout\" requirement on or off."
msgstr "Ativa ou desativa a exigência de \"login antes da finalização\"."

#: Includes/WcForceAuthCheckoutSettings.php:126
msgid ""
"Uncheck to let guests buy without an account. When checked, guests are sent "
"to the account page before they can complete the purchase."
msgstr ""
"Desmarque para permitir que visitantes comprem sem conta. Quando marcado, os "
"visitantes são enviados à página de conta antes de concluir a compra."

#: Includes/WcForceAuthCheckoutSettings.php:129
#: Includes/WcForceAuthCheckoutSettings.php:134
msgid "Notice message"
msgstr "Mensagem de aviso"

#: Includes/WcForceAuthCheckoutSettings.php:133
msgid ""
"Message shown on the account page when a guest is redirected from the "
"checkout."
msgstr ""
"Mensagem exibida na página de conta quando um visitante é redirecionado da "
"finalização."

#: Includes/WcForceAuthCheckoutSettings.php:135
msgid "Text displayed to the redirected customer."
msgstr "Texto exibido ao cliente redirecionado."

#: Includes/WcForceAuthCheckoutSettings.php:136
msgid ""
"Shown as a WooCommerce notice on the account page. If left empty, the "
"default message is used."
msgstr ""
"Exibida como um aviso do WooCommerce na página de conta. Se deixada em "
"branco, a mensagem padrão é usada."

#: Includes/WcForceAuthCheckoutSettings.php:140
msgid "Pages"
msgstr "Páginas"

#: Includes/WcForceAuthCheckoutSettings.php:146
#: Includes/WcForceAuthCheckoutSettings.php:151
msgid "Login page URL"
msgstr "URL da página de login"

#: Includes/WcForceAuthCheckoutSettings.php:150
msgid "Page customers are sent to in order to authenticate."
msgstr "Página para onde os clientes são enviados para se autenticarem."

#: Includes/WcForceAuthCheckoutSettings.php:152
msgid "Where the guest is redirected to log in."
msgstr "Para onde o visitante é redirecionado para fazer login."

#: Includes/WcForceAuthCheckoutSettings.php:153
msgid ""
"Leave empty to use the WooCommerce \"My account\" page. Useful when you use "
"a custom login page."
msgstr ""
"Deixe em branco para usar a página \"Minha conta\" do WooCommerce. Útil "
"quando você usa uma página de login personalizada."

#: Includes/WcForceAuthCheckoutSettings.php:156
#: Includes/WcForceAuthCheckoutSettings.php:161
msgid "Checkout page URL"
msgstr "URL da página de finalização"

#: Includes/WcForceAuthCheckoutSettings.php:160
msgid "Page the customer is sent back to after authenticating."
msgstr "Página para onde o cliente é enviado de volta após se autenticar."

#: Includes/WcForceAuthCheckoutSettings.php:162
msgid "Where the logged-in customer returns to."
msgstr "Para onde o cliente autenticado retorna."

#: Includes/WcForceAuthCheckoutSettings.php:163
msgid ""
"Leave empty to use the WooCommerce checkout page. Useful when you use a "
"custom checkout page."
msgstr ""
"Deixe em branco para usar a página de finalização do WooCommerce. Útil "
"quando você usa uma página de finalização personalizada."

#: Includes/WcForceAuthCheckoutSettings.php:167
msgid "After login"
msgstr "Após o login"

#: Includes/WcForceAuthCheckoutSettings.php:173
#: Includes/WcForceAuthCheckoutSettings.php:182
msgid "Destination after login"
msgstr "Destino após o login"

#: Includes/WcForceAuthCheckoutSettings.php:177
msgid "Back to the checkout"
msgstr "Voltar para a finalização"

#: Includes/WcForceAuthCheckoutSettings.php:178
msgid "My account dashboard"
msgstr "Painel da minha conta"

#: Includes/WcForceAuthCheckoutSettings.php:181
msgid "Where the customer lands right after authenticating."
msgstr "Onde o cliente chega logo após se autenticar."

#: Includes/WcForceAuthCheckoutSettings.php:183
msgid "Landing page once the customer is authenticated."
msgstr "Página de destino depois que o cliente se autentica."

#: Includes/WcForceAuthCheckoutSettings.php:184
msgid ""
"\"Back to the checkout\" sends the customer to the checkout to finish the "
"purchase. \"My account dashboard\" sends them to their account area instead."
msgstr ""
"\"Voltar para a finalização\" envia o cliente para a finalização para "
"concluir a compra. \"Painel da minha conta\" o envia para a área da conta."

